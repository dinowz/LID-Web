# ==============================================================================
# LIND DIGITALIZATION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Petunjuk: Salin file ini menjadi .env dan sesuaikan nilainya dengan environment Anda.
# Command: cp .env.example .env (Linux/Mac) atau copy .env.example .env (Windows)

# ─── Database Configuration (Prisma / PostgreSQL) ─────────────────────────────
DATABASE_URL="postgresql://postgres:password_db_anda@localhost:5432/lid_digitalization?schema=public&connection_limit=10"

# ─── Server & Security Configuration ──────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=ganti_dengan_secret_key_jwt_yang_aman_32_karakter
JWT_EXPIRES_IN=1d

# ─── SMTP Email Configuration ──────────────────────────────────────────────────
# Konfigurasi server email untuk pengiriman PDF & Reminder Otomatis
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email_anda@gmail.com
SMTP_PASS=app_password_smtp_anda

# ─── Automatic Reminder Idle Days Configuration (dalam satuan hari) ───────────
# Pengingat Otomatis dikirim hingga 3x pengingat (dengan interval jeda H+N)

# 1. Inquiry Reminder (Status: OPEN)
# Default: 1 hari tanpa aktivitas
REMINDER_IDLE_DAYS=1

# 2. Quotation Reminder (Status: DRAFT)
# Default: 1 hari tanpa aktivitas
REMINDER_QUOTATION_IDLE_DAYS=1

# 3. Purchase Order (PO) Reminder (Status: REVIEW, WAITING_OC, READY)
# Konfigurasi idle days terpisah untuk masing-masing status PO:
REMINDER_PO_REVIEW_IDLE_DAYS=1
REMINDER_PO_WAITING_OC_IDLE_DAYS=3
REMINDER_PO_READY_IDLE_DAYS=3

# 4. Delivery / Logistic Reminder (Status: REVIEW_LOGISTIC, PACKED)
# Default: 1 hari tanpa aktivitas
REMINDER_DELIVERY_IDLE_DAYS=1

# 5. Service & Project Execution Reminder (Status: PENDING, IN_PROGRESS)
# Default: 1 hari tanpa aktivitas
REMINDER_EXECUTION_IDLE_DAYS=1

# 6. TFS Assignment Overdue Reminder
# Default: 3 hari setelah End Date
REMINDER_TFS_OVERDUE_DAYS=3

# 7. Ready to Invoice Reminder (DELIVERED, COMPLETED)
# Default: 2 hari tanpa invoice
REMINDER_READY_TO_INVOICE_IDLE_DAYS=2

# ─── System Operational / Sequence Settings ──────────────────────────────────
INQUIRY_START_NUMBER=31425
